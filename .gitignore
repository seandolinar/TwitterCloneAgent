coverage/
playwright-report/
test-results/
blob-report/

# Logs.
*.log
npm-debug.log*

# Local editor and operating-system files.
.idea/
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Desktop.ini

# Delta's managed checkouts, not shared .delta configuration.
/.delta/worktrees/

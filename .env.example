# Copy to .env. Keep .env private; never commit real credentials.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
WEB_PORT=3000
MAIL_UI_PORT=8025
COOKIE_SECURE=false

# Required: generate a URL-safe password, for example with openssl rand -hex 32.
POSTGRES_PASSWORD=

# Required in development AND production: two independently generated values.
# Run openssl rand -hex 32 separately for each. Minimum 32 bytes per value.
# Keep them stable across restarts and identical across backend instances.
# Never reuse one for the other, commit them, or paste them into chat.
CSRF_SECRET=
RATE_LIMIT_SECRET=

# Development mail catcher. Production needs external TLS-authenticated SMTP.
EMAIL_FROM=noreply@example.test
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional integration. Leave the entire group empty until Unkey is configured.
UNKEY_MANAGEMENT_ROOT_KEY=
UNKEY_API_ID=
UNKEY_KEYSPACE_ID=

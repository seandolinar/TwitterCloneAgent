# Runtime-only placeholders. Supply independently for production and preview.
# Do not put populated copies in source control or Docker build contexts.
APP_ENV=production
NODE_ENV=production
WEB_RUNTIME_MODE=compute
HOST=0.0.0.0
PORT=8080
BROWSER_BIND=127.0.0.1:8081
GATEWAY_BIND=127.0.0.1:8082
API_BASE_URL=http://127.0.0.1:8081
GATEWAY_API_BASE_URL=http://127.0.0.1:8082
APP_ORIGIN=https://REPLACE_ENVIRONMENT_DOMAIN
COOKIE_SECURE=true
# Authenticated external PostgreSQL, database per environment, verified TLS.
DATABASE_URL=
# Generate separately; stable across restarts/replicas in just this environment.
CSRF_SECRET=
RATE_LIMIT_SECRET=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
# Create/delete only, scoped to this environment's keyspace.
UNKEY_MANAGEMENT_ROOT_KEY=
UNKEY_API_ID=
UNKEY_KEYSPACE_ID=
UNKEY_REQUESTS_PER_MINUTE=60
SOCIAL_WRITES_PER_MINUTE=30
# No verify root in the app: Compute's managed gateway performs verification.
